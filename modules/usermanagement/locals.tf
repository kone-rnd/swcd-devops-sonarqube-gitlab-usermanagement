locals {
  # Shared inputs live at the repo root (same GitLab org for every environment).
  access = jsondecode(file("${path.module}/../../gitlab-user-data/gitlab-access.json"))[0]
  users  = local.access.user_details  # "<uid>" => { name, username, email }
  scopes = local.access.scope_details # [{ scope, id, parent_id, access_details }]

  parents = yamldecode(file("${path.module}/../../config/config.yml"))["parent-groups"]

  # Direct subgroups of each parent as {key, scope}. Key = subgroup leaf as-is
  # (e.g. derp-monitoring), giving the SonarQube key pattern derp-monitoring.*.
  pg_pairs = flatten([
    for p in local.parents : [
      for s in local.scopes : {
        key   = trimprefix(s.scope, "${p}/")
        scope = s
      }
      if startswith(s.scope, "${p}/") && length(split("/", trimprefix(s.scope, "${p}/"))) == 1
    ]
  ])

  # Group scopes by key: the same leaf can exist under multiple parents (e.g. devops),
  # so union their members into one template instead of one overwriting the other.
  project_groups = {
    for key in distinct([for x in local.pg_pairs : x.key]) :
    key => [for x in local.pg_pairs : x.scope if x.key == key]
  }

  tier_permissions = {
    admin     = ["admin", "issueadmin", "securityhotspotadmin", "codeviewer", "user"]
    developer = ["codeviewer", "user"]
  }

  # Per project group (union across scopes sharing the key): admin = Owner+Maintainer;
  # developer = everyone else (incl. Reporter) except No access.
  pg_uids = {
    for key, scopes in local.project_groups : key => {
      admin = toset(flatten([
        for s in scopes : concat(lookup(s.access_details, "Owner", []), lookup(s.access_details, "Maintainer", []))
      ]))
      developer = setsubtract(
        toset(flatten([for s in scopes : flatten(values(s.access_details))])),
        toset(flatten([
          for s in scopes : concat(
            lookup(s.access_details, "Owner", []),
            lookup(s.access_details, "Maintainer", []),
            lookup(s.access_details, "No access", []),
          )
        ]))
      )
    }
  }

  # One SonarQube group per project group and tier.
  group_tiers = merge([
    for key, scopes in local.project_groups : {
      "${key}-admin"     = { project_group = key, permissions = local.tier_permissions.admin, uids = local.pg_uids[key].admin }
      "${key}-developer" = { project_group = key, permissions = local.tier_permissions.developer, uids = local.pg_uids[key].developer }
    }
  ]...)

  # Identity resolution: GitLab user email -> SonarQube login (SAML accounts only,
  # generated by services/sonar_saml_users.py), so GitLab-SSO duplicates never match.
  email_by_uid         = { for uid, u in local.users : uid => lower(u.email) if u.email != "" }
  sonar_login_by_email = fileexists(var.saml_users_file) ? jsondecode(file(var.saml_users_file)) : {}

  # Matched (group, SonarQube login) assignments; unmatched members are dropped.
  assignments = {
    for a in flatten([
      for gkey, g in local.group_tiers : [
        for uid in g.uids : {
          group = gkey
          login = lookup(local.sonar_login_by_email, lookup(local.email_by_uid, tostring(uid), ""), "")
        }
      ]
    ]) :
    "${a.group}:${a.login}" => a if a.login != ""
  }
}
